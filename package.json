{
  "name": "pt-journal",
  "version": "0.1.0",
  "productName": "PT Journal",
  "description": "Read-only statistics viewer for Platinum Together",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "online.platinumtogether.ptjournal",
    "productName": "PT Journal",
    "copyright": "Fan-made, read-only stat viewer",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "parser.js",
      "spawns-build.js",
      "wiki-updater.js",
      "species.json",
      "icon.ico",
      "package.json",
      "renderer/**/*",
      "data/**/*",
      "species-extra.json"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PT Journal",
      "deleteAppDataOnUninstall": false,
      "artifactName": "PTJournal-${version}-Setup.${ext}"
    },
    "extraFiles": [
      {
        "from": "extras/Create-Shortcut.bat",
        "to": "."
      }
    ]
  }
}
